    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "df = pd.read_csv('../data/raw/portfolio_df.csv', parse_dates=['timestamp'])\n",
    "df['default_rate'] = df['default_flag'].rolling(window=30).mean()\n",
    "df.plot(x='timestamp', y='default_rate')\n",
    "plt.show()"
